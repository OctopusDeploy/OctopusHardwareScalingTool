@page "/"
@rendermode InteractiveServer

<PageTitle>Octopus Deploy - Hardware Sizing Calculator</PageTitle>

<div class="hardware-scaling-calculator">
    <!-- Octopus-style Header -->
    <header class="octopus-header">
        <div class="header-container">
            <div class="header-content">
                <h1>Octopus Deploy Hardware Sizing Calculator</h1>
                <p>Size your infrastructure correctly for your deployment needs</p>
            </div>
        </div>
    </header>

    <!-- Tab Navigation -->
    <div class="pricing-tabs-container">
        <div class="container">
            <div class="pricing-tabs">
                <button class="pricing-tab @(activeTab == "server" ? "active" : "")" @onclick="@(() => SwitchTab("server"))">
                    <span class="tab-icon">🖥️</span>
                    Octopus Server
                </button>
                <button class="pricing-tab @(activeTab == "cloud" ? "active" : "")" @onclick="@(() => SwitchTab("cloud"))">
                    <span class="tab-icon">☁️</span>
                    Octopus Cloud
                </button>
            </div>
        </div>
    </div>

    <div class="calculator-section">
        <div class="container">
            @if (activeTab == "server")
            {
                <!-- Server Tab Content -->
            <!-- Preset Selector -->
            <div class="preset-selector">
                <h3>Quick Start: Choose a Preset Configuration</h3>
                <div class="preset-buttons">
                    <button class="preset-btn @(selectedPreset == "retail" ? "active" : "")" @onclick="@(() => ApplyPreset("retail"))">
                        🏪 Retail Chain
                        <span class="preset-desc">Many locations, multiple devices each</span>
                    </button>
                    <button class="preset-btn @(selectedPreset == "regional" ? "active" : "")" @onclick="@(() => ApplyPreset("regional"))">
                        🏢 Regional Business
                        <span class="preset-desc">Moderate locations, more devices</span>
                    </button>
                    <button class="preset-btn @(selectedPreset == "enterprise" ? "active" : "")" @onclick="@(() => ApplyPreset("enterprise"))">
                        🏛️ Enterprise
                        <span class="preset-desc">Few locations, many devices</span>
                    </button>
                    <button class="preset-btn @(selectedPreset == "custom" ? "active" : "")" @onclick="@(() => ApplyPreset("custom"))">
                        ⚙️ Custom
                        <span class="preset-desc">Configure your own scenario</span>
                    </button>
                </div>
            </div>

            <!-- Step 1: Describe Your Deployment Scenario -->
            <div class="calculator-card">
                <h2>Step 1: Describe Your Deployment Scenario</h2>
                <p class="section-intro">Tell us about your deployment infrastructure and nightly maintenance window.</p>

                <div class="input-section">
                    <div class="input-group">
                        <label for="numLocations" class="form-label">
                            <strong>Number of Locations/Stores</strong>
                            <span class="help-text">How many physical locations do you deploy to?</span>
                        </label>
                        <input type="range"
                               id="numLocations"
                               class="form-range"
                               min="1"
                               max="500"
                               step="1"
                               @bind="selectedLocations"
                               @bind:event="oninput" />
                        <div class="range-value">@selectedLocations locations</div>
                    </div>

                    <div class="input-group">
                        <label for="devicesPerLocation" class="form-label">
                            <strong>Devices per Location</strong>
                            <span class="help-text">Average number of devices (POS, servers, etc.) at each location</span>
                        </label>
                        <input type="range"
                               id="devicesPerLocation"
                               class="form-range"
                               min="1"
                               max="50"
                               step="1"
                               @bind="selectedDevicesPerLocation"
                               @bind:event="oninput" />
                        <div class="range-value">@selectedDevicesPerLocation devices</div>
                    </div>

                    <div class="input-group">
                        <label for="applicationsDeployed" class="form-label">
                            <strong>Applications to Deploy</strong>
                            <span class="help-text">How many applications are deployed together?</span>
                        </label>
                        <input type="range"
                               id="applicationsDeployed"
                               class="form-range"
                               min="1"
                               max="10"
                               step="1"
                               @bind="selectedApplications"
                               @bind:event="oninput" />
                        <div class="range-value">@selectedApplications applications</div>
                    </div>

                    <div class="input-group">
                        <label for="deploymentWindow" class="form-label">
                            <strong>Deployment Window</strong>
                            <span class="help-text">Hours available for nightly deployments</span>
                        </label>
                        <input type="range"
                               id="deploymentWindow"
                               class="form-range"
                               min="1"
                               max="8"
                               step="0.5"
                               @bind="selectedDeploymentWindow"
                               @bind:event="oninput" />
                        <div class="range-value">@selectedDeploymentWindow hours</div>
                    </div>
                </div>

                <div class="scenario-summary">
                    <h4>Your Deployment Scenario:</h4>
                    <div class="summary-grid">
                        <div class="summary-item">
                            <span class="summary-label">Total Deployment Targets:</span>
                            <span class="summary-value">@(selectedLocations * selectedDevicesPerLocation)</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Total Application Deployments:</span>
                            <span class="summary-value">@(selectedLocations * selectedApplications)</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">Deployment Window:</span>
                            <span class="summary-value">@selectedDeploymentWindow hours (nightly)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 2: Infrastructure Requirements -->
            <div class="calculator-card">
                <h2>Step 2: Your Infrastructure Requirements</h2>
                <p class="section-intro">Based on your deployment scenario, here's what you'll need:</p>

                <div class="requirements-container">
                    <div class="requirement-highlight">
                        <h3>Recommended Hardware Specifications</h3>
                        <div class="hardware-recommendation">
                            <div class="hardware-item">
                                <span class="hardware-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                                        <rect x="9" y="9" width="6" height="6"></rect>
                                        <line x1="9" y1="1" x2="9" y2="4"></line>
                                        <line x1="15" y1="1" x2="15" y2="4"></line>
                                        <line x1="9" y1="20" x2="9" y2="23"></line>
                                        <line x1="15" y1="20" x2="15" y2="23"></line>
                                        <line x1="20" y1="9" x2="23" y2="9"></line>
                                        <line x1="20" y1="14" x2="23" y2="14"></line>
                                        <line x1="1" y1="9" x2="4" y2="9"></line>
                                        <line x1="1" y1="14" x2="4" y2="14"></line>
                                    </svg>
                                </span>
                                <div class="hardware-details">
                                    <strong>Minimum CPU Cores Required:</strong>
                                    <span class="hardware-value">@recommendedCores cores</span>
                                </div>
                            </div>
                            <div class="hardware-item">
                                <span class="hardware-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2" y="7" width="20" height="10" rx="2" ry="2"></rect>
                                        <path d="M6 11v2"></path>
                                        <path d="M10 11v2"></path>
                                        <path d="M14 11v2"></path>
                                        <path d="M18 11v2"></path>
                                        <path d="M7 7V5a1 1 0 0 1 1-1h2"></path>
                                        <path d="M14 5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2"></path>
                                        <path d="M7 17v2a1 1 0 0 0 1 1h2"></path>
                                        <path d="M14 20a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-2"></path>
                                    </svg>
                                </span>
                                <div class="hardware-details">
                                    <strong>Recommended RAM:</strong>
                                    <span class="hardware-value">@recommendedRam GB</span>
                                </div>
                            </div>
                            <div class="hardware-item">
                                <span class="hardware-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                                        <path d="M21 12v7"></path>
                                    </svg>
                                </span>
                                <div class="hardware-details">
                                    <strong>Database Server Cores:</strong>
                                    <span class="hardware-value">@recommendedDbCores cores</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="deployment-window-analysis">
                        <h4>Deployment Window Feasibility</h4>
                        <div class="window-status @GetWindowStatusClass()">
                            <div class="window-icon">@GetWindowStatusIcon()</div>
                            <div class="window-details">
                                <strong>@GetWindowStatusTitle()</strong>
                                <p>Estimated time to deploy to all @selectedLocations locations: <strong>@estimatedDeploymentTime.ToString("F1") hours</strong></p>
                                @if (estimatedDeploymentTime > selectedDeploymentWindow)
                                {
                                    <p class="warning-text">⚠️ Your deployment will take @((estimatedDeploymentTime - selectedDeploymentWindow).ToString("F1")) hours longer than your window allows!</p>
                                }
                                else
                                {
                                    <p class="success-text">✅ Deployments will complete with @((selectedDeploymentWindow - estimatedDeploymentTime).ToString("F1")) hours to spare.</p>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="performance-breakdown">
                        <h4>Expected Resource Utilization</h4>
                        <div class="performance-details">
                            <div class="performance-metric">
                                <span class="metric-label">Application Server CPU</span>
                                <div class="metric-bar-container">
                                    <div class="metric-bar @GetMetricBarClass(estimatedVmCpu)" style="width: @estimatedVmCpu%"></div>
                                </div>
                                <span class="metric-value">@estimatedVmCpu%</span>
                            </div>
                            <div class="performance-metric">
                                <span class="metric-label">Database Server CPU</span>
                                <div class="metric-bar-container">
                                    <div class="metric-bar @GetMetricBarClass(estimatedDbCpu)" style="width: @estimatedDbCpu%"></div>
                                </div>
                                <span class="metric-value">@estimatedDbCpu%</span>
                            </div>
                            <div class="performance-metric">
                                <span class="metric-label">Network Bandwidth Usage</span>
                                <div class="metric-bar-container">
                                    <div class="metric-bar @GetMetricBarClass(estimatedNetworkUsage)" style="width: @estimatedNetworkUsage%"></div>
                                </div>
                                <span class="metric-value">@estimatedNetworkUsage%</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 3: Fine-tune Your Hardware -->
            <div class="calculator-card">
                <h2>Step 3: Fine-tune Your Hardware Configuration</h2>
                <p class="section-intro">Adjust your available hardware to see how it affects deployment times and performance.</p>

                <div class="hardware-tuning">
                    <div class="input-group">
                        <label for="cpuCores" class="form-label">
                            <strong>Available CPU Cores</strong>
                            <span class="help-text">How many CPU cores can you allocate to your Octopus Server?</span>
                        </label>
                        <input type="range"
                               id="cpuCores"
                               class="form-range"
                               min="2"
                               max="32"
                               step="1"
                               @bind="selectedCpuCores"
                               @bind:event="oninput" />
                        <div class="range-value">@selectedCpuCores cores</div>
                    </div>

                    <div class="tuning-impact">
                        <h4>Impact on Your Deployments</h4>
                        <div class="impact-grid">
                            <div class="impact-item @(selectedCpuCores >= recommendedCores ? "positive" : "negative")">
                                <span class="impact-label">Hardware Status:</span>
                                <span class="impact-value">
                                    @if (selectedCpuCores >= recommendedCores)
                                    {
                                        <text>✅ Meets Requirements</text>
                                    }
                                    else
                                    {
                                        <text>⚠️ Below Recommended (@(recommendedCores - selectedCpuCores) more cores needed)</text>
                                    }
                                </span>
                            </div>
                            <div class="impact-item">
                                <span class="impact-label">Deployment Time:</span>
                                <span class="impact-value">@estimatedDeploymentTime.ToString("F1") hours</span>
                            </div>
                            <div class="impact-item @(estimatedDeploymentTime <= selectedDeploymentWindow ? "positive" : "negative")">
                                <span class="impact-label">Fits in Window:</span>
                                <span class="impact-value">
                                    @if (estimatedDeploymentTime <= selectedDeploymentWindow)
                                    {
                                        <text>✅ Yes (@((selectedDeploymentWindow - estimatedDeploymentTime).ToString("F1"))h buffer)</text>
                                    }
                                    else
                                    {
                                        <text>❌ No (@((estimatedDeploymentTime - selectedDeploymentWindow).ToString("F1"))h over)</text>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>

                    @if (selectedCpuCores < recommendedCores)
                    {
                        <div class="recommendation-card warning">
                            <h4>⚠️ Hardware Upgrade Recommended</h4>
                            <p>
                                Your current configuration of @selectedCpuCores cores is below the recommended @recommendedCores cores
                                for your deployment scenario. This may result in:
                            </p>
                            <ul>
                                <li>Deployments taking longer than your maintenance window</li>
                                <li>Queuing delays during peak deployment times</li>
                                <li>Poor performance when deploying to multiple locations simultaneously</li>
                            </ul>
                        </div>
                    }
                    else if (selectedCpuCores > recommendedCores + 8)
                    {
                        <div class="recommendation-card info">
                            <h4>💡 Optimization Opportunity</h4>
                            <p>
                                You have @(selectedCpuCores - recommendedCores) more cores than needed for your current scenario.
                                Consider using the extra capacity for:
                            </p>
                            <ul>
                                <li>Running more concurrent deployments</li>
                                <li>Reducing deployment times further</li>
                                <li>Handling future growth without hardware changes</li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
            }
            else if (activeTab == "cloud")
            {
                <!-- Cloud Tab Content -->
                <div class="calculator-card">
                    <h2>Octopus Cloud - Budget-Based Sizing</h2>
                    <p class="section-intro">
                        With Octopus Cloud, we automatically scale to meet your needs.
                        Set your monthly budget and we'll show you what performance to expect.
                    </p>

                    <div class="cloud-calculator">
                        <div class="input-group">
                            <label for="monthlyBudget" class="form-label">
                                <strong>Monthly Budget</strong>
                                <span class="help-text">Your cloud infrastructure budget per month (USD)</span>
                            </label>
                            <input type="range"
                                   id="monthlyBudget"
                                   class="form-range"
                                   min="100"
                                   max="10000"
                                   step="100"
                                   @bind="monthlyBudget"
                                   @bind:event="oninput" />
                            <div class="range-value budget-value">$@monthlyBudget.ToString("N0") / month</div>
                        </div>

                        <div class="cloud-capabilities">
                            <h3>What You Get</h3>
                            <div class="capability-grid">
                                <div class="capability-card">
                                    <div class="capability-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                                            <rect x="9" y="9" width="6" height="6"></rect>
                                            <line x1="9" y1="1" x2="9" y2="4"></line>
                                            <line x1="15" y1="1" x2="15" y2="4"></line>
                                            <line x1="9" y1="20" x2="9" y2="23"></line>
                                            <line x1="15" y1="20" x2="15" y2="23"></line>
                                            <line x1="20" y1="9" x2="23" y2="9"></line>
                                            <line x1="20" y1="14" x2="23" y2="14"></line>
                                            <line x1="1" y1="9" x2="4" y2="9"></line>
                                            <line x1="1" y1="14" x2="4" y2="14"></line>
                                        </svg>
                                    </div>
                                    <div class="capability-details">
                                        <strong>Available CPU Cores</strong>
                                        <span class="capability-value">@cloudCores cores</span>
                                        <span class="capability-note">Auto-scaling based on demand</span>
                                    </div>
                                </div>

                                <div class="capability-card">
                                    <div class="capability-icon">🏪</div>
                                    <div class="capability-details">
                                        <strong>Supported Locations</strong>
                                        <span class="capability-value">Up to @maxCloudLocations locations</span>
                                        <span class="capability-note">With @selectedDevicesPerLocation devices each</span>
                                    </div>
                                </div>

                                <div class="capability-card">
                                    <div class="capability-icon">⚡</div>
                                    <div class="capability-details">
                                        <strong>Deployment Time</strong>
                                        <span class="capability-value">@cloudDeploymentTime.ToString("F1") hours</span>
                                        <span class="capability-note">For all locations</span>
                                    </div>
                                </div>

                                <div class="capability-card">
                                    <div class="capability-icon">✨</div>
                                    <div class="capability-details">
                                        <strong>Included Features</strong>
                                        <ul class="feature-list">
                                            <li>Automatic scaling</li>
                                            <li>High availability</li>
                                            <li>Automated backups</li>
                                            <li>24/7 monitoring</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="cloud-recommendation">
                            @if (cloudDeploymentTime <= selectedDeploymentWindow)
                            {
                                <div class="recommendation-card success">
                                    <h4>✅ Your Budget Meets Your Needs</h4>
                                    <p>
                                        With a budget of <strong>$@monthlyBudget.ToString("N0")</strong> per month,
                                        you can deploy to all @selectedLocations locations within your @selectedDeploymentWindow hour window.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <div class="recommendation-card warning">
                                    <h4>⚠️ Consider Increasing Your Budget</h4>
                                    <p>
                                        To deploy to all @selectedLocations locations within @selectedDeploymentWindow hours,
                                        we recommend a budget of <strong>$@recommendedBudget.ToString("N0")</strong> per month
                                        (@recommendedCloudCores cores).
                                    </p>
                                    <p class="budget-tip">
                                        Current budget provides @cloudCores cores. You need @(recommendedCloudCores - cloudCores) more cores.
                                    </p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // Tab management
    private string activeTab = "server";

    // Cloud pricing variables
    private decimal monthlyBudget = 1000;
    private int cloudCores => (int)(monthlyBudget / 100); // $100 per core
    private int maxCloudLocations => cloudCores * 10; // Estimate based on cores
    private double cloudDeploymentTime => CalculateCloudDeploymentTime();
    private decimal recommendedBudget => recommendedCloudCores * 100;
    private int recommendedCloudCores => recommendedCores; // Use same calculation as server

    // Location-centric inputs with property setters
    private string selectedPreset = "custom";

    private int _selectedLocations = 50;
    private int selectedLocations
    {
        get => _selectedLocations;
        set
        {
            if (_selectedLocations != value)
            {
                _selectedLocations = value;
                CalculatePerformance();
            }
        }
    }

    private int _selectedDevicesPerLocation = 10;
    private int selectedDevicesPerLocation
    {
        get => _selectedDevicesPerLocation;
        set
        {
            if (_selectedDevicesPerLocation != value)
            {
                _selectedDevicesPerLocation = value;
                CalculatePerformance();
            }
        }
    }

    private int _selectedApplications = 3;
    private int selectedApplications
    {
        get => _selectedApplications;
        set
        {
            if (_selectedApplications != value)
            {
                _selectedApplications = value;
                CalculatePerformance();
            }
        }
    }

    private double _selectedDeploymentWindow = 4.0;
    private double selectedDeploymentWindow
    {
        get => _selectedDeploymentWindow;
        set
        {
            if (Math.Abs(_selectedDeploymentWindow - value) > 0.01)
            {
                _selectedDeploymentWindow = value;
                CalculatePerformance();
            }
        }
    }

    private int _selectedCpuCores = 4;
    private int selectedCpuCores
    {
        get => _selectedCpuCores;
        set
        {
            if (_selectedCpuCores != value)
            {
                _selectedCpuCores = value;
                CalculatePerformance();
            }
        }
    }

    // Infrastructure recommendations
    private int recommendedCores = 8;
    private int recommendedRam = 16;
    private int recommendedDbCores = 4;

    // Performance metrics
    private int estimatedVmCpu = 35;
    private int estimatedDbCpu = 10;
    private int estimatedNetworkUsage = 25;
    private double estimatedDeploymentTime = 2.5;

    // Flag to prevent recursion
    private bool _isCalculating = false;

    private enum PerformanceLevel
    {
        Optimal,
        Acceptable,
        Degraded
    }

    private PerformanceLevel currentPerformanceLevel = PerformanceLevel.Optimal;

    protected override void OnInitialized()
    {
        CalculatePerformance();
    }

    private void CalculatePerformance()
    {
        // Prevent recursion
        if (_isCalculating) return;

        try
        {
            _isCalculating = true;

            // Calculate total deployment workload
            int totalTargets = _selectedLocations * _selectedDevicesPerLocation;
            int totalDeployments = _selectedLocations * _selectedApplications;

            // Calculate recommended hardware based on workload
            // Application archetype: 20 steps, DB migrations, 1000 variables
            // Base: 2 cores can handle 10 targets with 5 concurrent deployments
            double workloadFactor = (totalTargets / 10.0) * (_selectedApplications / 2.0);
            recommendedCores = Math.Max(4, (int)Math.Ceiling(2 * Math.Sqrt(workloadFactor)));
            recommendedRam = recommendedCores * 4; // 4GB per core minimum
            recommendedDbCores = Math.Max(2, recommendedCores / 2);

            // Calculate performance with selected cores
            if (_selectedCpuCores > 0)
            {
                // Performance calculation based on Application archetype (20 steps)
                double coreRatio = _selectedCpuCores / (double)recommendedCores;

                // VM CPU usage inversely proportional to available cores
                estimatedVmCpu = Math.Min(100, (int)(70 / coreRatio));

                // DB CPU affected by concurrent operations
                estimatedDbCpu = Math.Min(100, (int)(50 / Math.Sqrt(coreRatio)));

                // Network usage based on locations and package size
                estimatedNetworkUsage = Math.Min(100, (int)(30 * (totalTargets / 100.0)));

                // Deployment time calculation (Application archetype: ~2 min per deployment per target)
                double baseTimePerDeployment = 2.0 / 60.0; // 2 minutes in hours
                double parallelism = Math.Min(_selectedCpuCores * 2, totalDeployments);
                estimatedDeploymentTime = (totalDeployments * baseTimePerDeployment * 20) / parallelism; // 20 steps

                // Adjust for network and edge device constraints
                if (totalTargets > 100)
                {
                    estimatedDeploymentTime *= 1.2; // 20% overhead for coordination
                }
            }

            currentPerformanceLevel = GetPerformanceLevelFromCpu(estimatedVmCpu, estimatedDbCpu);
        }
        finally
        {
            _isCalculating = false;
            StateHasChanged();  // Force UI update
        }
    }

    private PerformanceLevel GetPerformanceLevelFromCpu(int vmCpu, int dbCpu)
    {
        var maxCpu = Math.Max(vmCpu, dbCpu);
        if (maxCpu < 40) return PerformanceLevel.Optimal;
        if (maxCpu < 70) return PerformanceLevel.Acceptable;
        return PerformanceLevel.Degraded;
    }

    // Preset configurations
    private void ApplyPreset(string preset)
    {
        selectedPreset = preset;
        _isCalculating = true; // Prevent multiple recalculations

        switch (preset)
        {
            case "retail":
                _selectedLocations = 100;
                _selectedDevicesPerLocation = 10;
                _selectedApplications = 3;
                _selectedDeploymentWindow = 4.0;
                break;
            case "regional":
                _selectedLocations = 25;
                _selectedDevicesPerLocation = 20;
                _selectedApplications = 4;
                _selectedDeploymentWindow = 6.0;
                break;
            case "enterprise":
                _selectedLocations = 10;
                _selectedDevicesPerLocation = 50;
                _selectedApplications = 5;
                _selectedDeploymentWindow = 8.0;
                break;
            case "custom":
            default:
                // Keep current values
                break;
        }

        _isCalculating = false;
        CalculatePerformance();
    }

    // Window status helpers
    private string GetWindowStatusClass()
    {
        if (estimatedDeploymentTime <= selectedDeploymentWindow * 0.7)
            return "window-optimal";
        if (estimatedDeploymentTime <= selectedDeploymentWindow)
            return "window-acceptable";
        return "window-exceeded";
    }

    private string GetWindowStatusIcon()
    {
        if (estimatedDeploymentTime <= selectedDeploymentWindow * 0.7)
            return "✅";
        if (estimatedDeploymentTime <= selectedDeploymentWindow)
            return "⚠️";
        return "❌";
    }

    private string GetWindowStatusTitle()
    {
        if (estimatedDeploymentTime <= selectedDeploymentWindow * 0.7)
            return "Deployments fit comfortably in window";
        if (estimatedDeploymentTime <= selectedDeploymentWindow)
            return "Deployments fit but with little margin";
        return "Deployments exceed maintenance window";
    }

    // Metric bar color helpers
    private string GetMetricBarClass(int usage)
    {
        if (usage < 40) return "metric-bar-optimal";
        if (usage < 70) return "metric-bar-acceptable";
        return "metric-bar-degraded";
    }

    // Performance badge helpers (kept for compatibility)
    private string GetPerformanceBadgeClass()
    {
        return currentPerformanceLevel switch
        {
            PerformanceLevel.Optimal => "badge-optimal",
            PerformanceLevel.Acceptable => "badge-acceptable",
            PerformanceLevel.Degraded => "badge-degraded",
            _ => ""
        };
    }

    private string GetPerformanceIcon()
    {
        return currentPerformanceLevel switch
        {
            PerformanceLevel.Optimal => "🟢",
            PerformanceLevel.Acceptable => "🟡",
            PerformanceLevel.Degraded => "🔴",
            _ => ""
        };
    }

    private string GetPerformanceTitle()
    {
        return currentPerformanceLevel switch
        {
            PerformanceLevel.Optimal => "Optimal Performance",
            PerformanceLevel.Acceptable => "Acceptable Performance",
            PerformanceLevel.Degraded => "Degraded Performance",
            _ => ""
        };
    }

    private string GetPerformanceDescription()
    {
        return currentPerformanceLevel switch
        {
            PerformanceLevel.Optimal => "Your deployments will run smoothly with plenty of capacity for growth.",
            PerformanceLevel.Acceptable => "Your deployments will generally work well, but you might experience some slowdowns during peak usage.",
            PerformanceLevel.Degraded => "Your server will struggle with this workload. Expect queueing delays and slower deployments.",
            _ => ""
        };
    }

    // Tab switching
    private void SwitchTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }

    // Cloud deployment time calculation
    private double CalculateCloudDeploymentTime()
    {
        if (cloudCores == 0) return 999; // Very high time if no budget

        // Similar calculation to server, but using cloud cores
        int totalTargets = _selectedLocations * _selectedDevicesPerLocation;
        int totalDeployments = _selectedLocations * _selectedApplications;

        double baseTimePerDeployment = 2.0 / 60.0; // 2 minutes in hours
        double parallelism = Math.Min(cloudCores * 2, totalDeployments);
        double deploymentTime = (totalDeployments * baseTimePerDeployment * 20) / parallelism;

        // Cloud has better network, so less overhead
        if (totalTargets > 100)
        {
            deploymentTime *= 1.1; // Only 10% overhead vs 20% for on-prem
        }

        return deploymentTime;
    }
}
