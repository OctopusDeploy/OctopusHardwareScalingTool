@page "/"
@rendermode InteractiveServer

<PageTitle>Octopus Deploy - Hardware Scaling Calculator</PageTitle>

<div class="hardware-scaling-calculator">
    <div class="hero-section">
        <div class="container">
            <h1>Will Octopus Perform Well For You?</h1>
            <p class="lead">
                Describe your typical deployment scenario and find out if you'll experience optimal performance
                or if you should consider upgrading your hardware resources.
            </p>
        </div>
    </div>

    <div class="calculator-section">
        <div class="container">
            <!-- Step 1: Describe Your Deployment Scenario -->
            <div class="calculator-card">
                <h2>Step 1: Describe Your Deployment Scenario</h2>
                <p class="section-intro">Tell us about your typical deployment workload so we can assess performance.</p>

                <div class="input-section">
                    <div class="input-group">
                        <label for="parallelTargets" class="form-label">
                            <strong>Parallel Targets per Deployment</strong>
                            <span class="help-text">How many deployment targets execute simultaneously in each deployment?</span>
                        </label>
                        <input type="range"
                               id="parallelTargets"
                               class="form-range"
                               min="1"
                               max="20"
                               step="1"
                               @bind="selectedParallelTargets"
                               @bind:event="oninput" />
                        <div class="range-value">@selectedParallelTargets targets</div>
                    </div>

                    <div class="input-group">
                        <label for="numDeployments" class="form-label">
                            <strong>Deployments in a Typical Batch</strong>
                            <span class="help-text">How many deployments do you typically run together?</span>
                        </label>
                        <input type="range"
                               id="numDeployments"
                               class="form-range"
                               min="10"
                               max="200"
                               step="10"
                               @bind="selectedNumDeployments"
                               @bind:event="oninput" />
                        <div class="range-value">@selectedNumDeployments deployments</div>
                    </div>

                    <div class="input-group">
                        <label for="taskCap" class="form-label">
                            <strong>Task Cap Setting</strong>
                            <span class="help-text">Maximum concurrent deployments (your Octopus Server task cap setting)</span>
                        </label>
                        <select id="taskCap" class="form-select" @onchange="OnTaskCapChanged">
                            <option value="5" selected="@(selectedTaskCap == 5)">5 concurrent deployments</option>
                            <option value="10" selected="@(selectedTaskCap == 10)">10 concurrent deployments</option>
                            <option value="20" selected="@(selectedTaskCap == 20)">20 concurrent deployments</option>
                            <option value="40" selected="@(selectedTaskCap == 40)">40 concurrent deployments</option>
                            <option value="80" selected="@(selectedTaskCap == 80)">80 concurrent deployments</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Step 2: Performance Assessment -->
            <div class="calculator-card">
                <h2>Step 2: Your Expected Performance</h2>
                <p class="section-intro">Based on your deployment scenario with our <strong>Standard Plan (2 CPU cores)</strong>:</p>

                <div class="performance-status-container">
                    <div class="performance-badge @GetPerformanceBadgeClass()">
                        <div class="performance-icon">@GetPerformanceIcon()</div>
                        <div class="performance-content">
                            <h3>@GetPerformanceTitle()</h3>
                            <p>@GetPerformanceDescription()</p>
                        </div>
                    </div>

                    <div class="performance-details">
                        <div class="performance-metric">
                            <span class="metric-label">VM CPU Utilization</span>
                            <div class="metric-bar-container">
                                <div class="metric-bar" style="width: @estimatedVmCpu%"></div>
                            </div>
                            <span class="metric-value">@estimatedVmCpu%</span>
                        </div>
                        <div class="performance-metric">
                            <span class="metric-label">Database CPU Utilization</span>
                            <div class="metric-bar-container">
                                <div class="metric-bar" style="width: @estimatedDbCpu%"></div>
                            </div>
                            <span class="metric-value">@estimatedDbCpu%</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 3: Upgrade Path (conditional) -->
            @if (currentPerformanceLevel != PerformanceLevel.Optimal)
            {
                <div class="calculator-card upgrade-section">
                    <h2>Step 3: Improve Your Performance</h2>
                    <p class="section-intro">
                        @if (currentPerformanceLevel == PerformanceLevel.Degraded)
                        {
                            <text>Your deployment scenario will experience degraded performance on 2 cores. Consider upgrading to improve performance.</text>
                        }
                        else
                        {
                            <text>Your deployment scenario is acceptable but could be optimized. Consider upgrading for better headroom.</text>
                        }
                    </p>

                    <div class="upgrade-controls">
                        <label for="upgradeCores" class="form-label">
                            <strong>Select CPU Cores</strong>
                            <span class="help-text">See how additional cores improve your performance</span>
                        </label>
                        <input type="range"
                               id="upgradeCores"
                               class="form-range upgrade-slider"
                               min="2"
                               max="8"
                               step="0.5"
                               @bind="upgradeCpuCores"
                               @bind:event="oninput" />
                        <div class="range-value-large">@upgradeCpuCores Cores</div>
                    </div>

                    <div class="upgrade-comparison">
                        <div class="comparison-column">
                            <h4>Current (2 Cores)</h4>
                            <div class="comparison-badge @GetPerformanceBadgeClass()">
                                @GetPerformanceIcon() @GetPerformanceTitle()
                            </div>
                            <div class="comparison-metrics">
                                <div>VM CPU: @estimatedVmCpu%</div>
                                <div>DB CPU: @estimatedDbCpu%</div>
                            </div>
                        </div>

                        <div class="comparison-arrow">→</div>

                        <div class="comparison-column">
                            <h4>Upgraded (@upgradeCpuCores Cores)</h4>
                            <div class="comparison-badge @GetUpgradePerformanceBadgeClass()">
                                @GetUpgradePerformanceIcon() @GetUpgradePerformanceTitle()
                            </div>
                            <div class="comparison-metrics">
                                <div>VM CPU: @upgradedVmCpu%</div>
                                <div>DB CPU: @upgradedDbCpu%</div>
                            </div>
                        </div>
                    </div>

                    @if (GetUpgradePerformanceLevel() == PerformanceLevel.Optimal)
                    {
                        <div class="recommendation-card success">
                            <h4>✅ Recommended Configuration</h4>
                            <p>Upgrading to @upgradeCpuCores cores will give you optimal performance with plenty of headroom for growth.</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="calculator-card success-section">
                    <div class="success-message">
                        <div class="success-icon">🎉</div>
                        <h3>Perfect! You're All Set</h3>
                        <p>Your deployment scenario will run great on our Standard Plan (2 cores). You have plenty of headroom for occasional spikes.</p>
                    </div>
                </div>
            }

            <!-- Educational Content -->
            <div class="info-section">
                <h3>Understanding Performance Levels</h3>
                <div class="info-grid">
                    <div class="info-card">
                        <h4>🟢 Optimal Performance</h4>
                        <p>
                            <strong>CPU &lt; 40%:</strong> Excellent! Your server has plenty of capacity.
                            Deployments will run smoothly with room for growth and occasional spikes in activity.
                        </p>
                    </div>
                    <div class="info-card">
                        <h4>🟡 Acceptable Performance</h4>
                        <p>
                            <strong>CPU 40-70%:</strong> Your deployments will generally work well, but you might
                            experience some slowdowns during peak usage. Consider upgrading if you plan to increase deployment frequency.
                        </p>
                    </div>
                    <div class="info-card">
                        <h4>🔴 Degraded Performance</h4>
                        <p>
                            <strong>CPU &gt; 70%:</strong> Your server will struggle with this workload.
                            Expect queueing delays and slower deployments. We strongly recommend upgrading your CPU cores.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // User inputs with property setters
    private int _selectedParallelTargets = 10;
    private int selectedParallelTargets
    {
        get => _selectedParallelTargets;
        set
        {
            if (_selectedParallelTargets != value)
            {
                _selectedParallelTargets = value;
                CalculatePerformance();
            }
        }
    }

    private int _selectedNumDeployments = 100;
    private int selectedNumDeployments
    {
        get => _selectedNumDeployments;
        set
        {
            if (_selectedNumDeployments != value)
            {
                _selectedNumDeployments = value;
                CalculatePerformance();
            }
        }
    }

    private int _selectedTaskCap = 20;
    private int selectedTaskCap
    {
        get => _selectedTaskCap;
        set
        {
            if (_selectedTaskCap != value)
            {
                _selectedTaskCap = value;
                CalculatePerformance();
            }
        }
    }

    // Performance calculation for 2 cores (baseline)
    private int estimatedVmCpu = 35;
    private int estimatedDbCpu = 10;

    // Flag to prevent recursion
    private bool _isCalculating = false;

    // Upgrade path with property setter
    private double _upgradeCpuCores = 4.0;
    private double upgradeCpuCores
    {
        get => _upgradeCpuCores;
        set
        {
            if (Math.Abs(_upgradeCpuCores - value) > 0.01)
            {
                _upgradeCpuCores = value;
                CalculatePerformance();
            }
        }
    }

    private int upgradedVmCpu = 0;
    private int upgradedDbCpu = 0;

    private enum PerformanceLevel
    {
        Optimal,
        Acceptable,
        Degraded
    }

    private PerformanceLevel currentPerformanceLevel = PerformanceLevel.Optimal;

    protected override void OnInitialized()
    {
        CalculatePerformance();
    }

    private void OnTaskCapChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var taskCap))
        {
            selectedTaskCap = taskCap;  // This will now trigger CalculatePerformance() via the setter
        }
    }

    private void CalculatePerformance()
    {
        // Prevent recursion
        if (_isCalculating) return;

        try
        {
            _isCalculating = true;

            // Calculate for 2 cores (baseline/standard plan)
            var baseline = CalculateForCores(2.0);
            estimatedVmCpu = baseline.VmCpu;
            estimatedDbCpu = baseline.DbCpu;
            currentPerformanceLevel = GetPerformanceLevelFromCpu(estimatedVmCpu, estimatedDbCpu);

            // Calculate for upgraded cores
            var upgraded = CalculateForCores(_upgradeCpuCores);  // Use backing field
            upgradedVmCpu = upgraded.VmCpu;
            upgradedDbCpu = upgraded.DbCpu;
        }
        finally
        {
            _isCalculating = false;
            StateHasChanged();  // Force UI update
        }
    }

    private (int VmCpu, int DbCpu) CalculateForCores(double cores)
    {
        // Base performance data from test results (2 cores, 10 targets, TC20)
        var baselineData = new
        {
            Cores = 2.0,
            Targets = 10,
            TaskCap = 20,
            VmCpu = 35,
            DbCpu = 10
        };

        // Calculate scaling factors - use backing fields to avoid triggering property setters
        var coreScaleFactor = baselineData.Cores / cores;
        var targetScaleFactor = _selectedParallelTargets / (double)baselineData.Targets;
        var taskCapScaleFactor = _selectedTaskCap / (double)baselineData.TaskCap;

        // Estimate CPU usage (more parallel work = higher CPU, more cores = lower per-core usage)
        var workloadFactor = targetScaleFactor * taskCapScaleFactor;
        var vmCpu = (int)(baselineData.VmCpu * workloadFactor * coreScaleFactor);
        var dbCpu = (int)(baselineData.DbCpu * workloadFactor * Math.Pow(coreScaleFactor, 0.5));

        // Cap CPU estimates at 100%
        vmCpu = Math.Min(vmCpu, 100);
        dbCpu = Math.Min(dbCpu, 100);

        return (vmCpu, dbCpu);
    }

    private PerformanceLevel GetPerformanceLevelFromCpu(int vmCpu, int dbCpu)
    {
        var maxCpu = Math.Max(vmCpu, dbCpu);
        if (maxCpu < 40) return PerformanceLevel.Optimal;
        if (maxCpu < 70) return PerformanceLevel.Acceptable;
        return PerformanceLevel.Degraded;
    }

    private PerformanceLevel GetUpgradePerformanceLevel()
    {
        return GetPerformanceLevelFromCpu(upgradedVmCpu, upgradedDbCpu);
    }

    // Performance badge helpers
    private string GetPerformanceBadgeClass()
    {
        return currentPerformanceLevel switch
        {
            PerformanceLevel.Optimal => "badge-optimal",
            PerformanceLevel.Acceptable => "badge-acceptable",
            PerformanceLevel.Degraded => "badge-degraded",
            _ => ""
        };
    }

    private string GetPerformanceIcon()
    {
        return currentPerformanceLevel switch
        {
            PerformanceLevel.Optimal => "🟢",
            PerformanceLevel.Acceptable => "🟡",
            PerformanceLevel.Degraded => "🔴",
            _ => ""
        };
    }

    private string GetPerformanceTitle()
    {
        return currentPerformanceLevel switch
        {
            PerformanceLevel.Optimal => "Optimal Performance",
            PerformanceLevel.Acceptable => "Acceptable Performance",
            PerformanceLevel.Degraded => "Degraded Performance",
            _ => ""
        };
    }

    private string GetPerformanceDescription()
    {
        return currentPerformanceLevel switch
        {
            PerformanceLevel.Optimal => "Your deployments will run smoothly with plenty of capacity for growth.",
            PerformanceLevel.Acceptable => "Your deployments will generally work well, but you might experience some slowdowns during peak usage.",
            PerformanceLevel.Degraded => "Your server will struggle with this workload. Expect queueing delays and slower deployments.",
            _ => ""
        };
    }

    // Upgrade badge helpers
    private string GetUpgradePerformanceBadgeClass()
    {
        return GetUpgradePerformanceLevel() switch
        {
            PerformanceLevel.Optimal => "badge-optimal",
            PerformanceLevel.Acceptable => "badge-acceptable",
            PerformanceLevel.Degraded => "badge-degraded",
            _ => ""
        };
    }

    private string GetUpgradePerformanceIcon()
    {
        return GetUpgradePerformanceLevel() switch
        {
            PerformanceLevel.Optimal => "🟢",
            PerformanceLevel.Acceptable => "🟡",
            PerformanceLevel.Degraded => "🔴",
            _ => ""
        };
    }

    private string GetUpgradePerformanceTitle()
    {
        return GetUpgradePerformanceLevel() switch
        {
            PerformanceLevel.Optimal => "Optimal",
            PerformanceLevel.Acceptable => "Acceptable",
            PerformanceLevel.Degraded => "Degraded",
            _ => ""
        };
    }
}
